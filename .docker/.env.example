# managed-coworkers data plane secrets.
# Copy to .docker/.env and fill in values. .env is gitignored.
#
# Generate strong passwords:
#   openssl rand -base64 32

# AlloyDB Omni Postgres superuser password.
ALLOYDB_PASSWORD=replace-me-with-openssl-rand-base64-32

# Redis 7 AUTH password.
REDIS_PASSWORD=replace-me-with-openssl-rand-base64-32

# Convenience connection strings (consumed by .mcp.json and app code).
# Hostnames `localhost`; ports match compose.yaml.
DATABASE_URL=postgres://postgres:${ALLOYDB_PASSWORD}@localhost:5433/coworkers
REDIS_URL=redis://default:${REDIS_PASSWORD}@localhost:6380
