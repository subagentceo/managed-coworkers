{
  "name": "managed-coworkers",
  "version": "0.1.1",
  "description": "Multi-agent research chassis with vendor doc mirror + MCP knowledge bridge.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist node_modules",
    "crawl:vendors": "tsx scripts/crawl-vendors.ts",
    "crawl:vendor": "tsx scripts/crawl-vendors.ts --vendor",
    "smoke:data-plane": "tsx scripts/smoke/data-plane.ts",
    "smoke:replay": "tsx src/lib/replay-harness.test.ts && tsx src/lib/miniflare-harness.test.ts && tsx src/lib/replay-miniflare-combined.test.ts && tsx src/lib/legal-replay-agent.test.ts && tsx src/lib/finance-replay-agent.test.ts && tsx src/lib/cookbook-replay.test.ts && tsx src/lib/cookbook-snapshot.test.ts && tsx src/lib/fetch-replay.test.ts && tsx src/lib/cassette-redact.test.ts && tsx src/index.test.ts",
    "redact:cassette": "tsx scripts/redact-cassette.ts",
    "canary:failclosed": "tsx src/lib/cookbook-replay-failclosed.canary.ts",
    "verify:typecheck": "tsc --noEmit",
    "verify:citations": "tsx scripts/lib/citation-guard.ts",
    "verify:libs": "tsx scripts/lib/run-tests.ts",
    "verify": "npm run verify:typecheck && npm run verify:citations && npm run verify:libs"
  },
  "author": "SubAgent CEO",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "@anthropic-ai/sdk": "^0.95.0",
    "@crawlee/cheerio": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openfeature/server-sdk": "^1.21.0",
    "@pollyjs/adapter-node-http": "^6.0.0",
    "@pollyjs/core": "^6.0.0",
    "@pollyjs/persister-fs": "^6.0.0",
    "@turbopuffer/turbopuffer": "^2.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.2.0",
    "mdast-util-from-markdown": "^2.0.3",
    "pdf-parse": "^2.4.5",
    "redis": "^5.12.1",
    "turndown": "^7.0.0",
    "undici": "^8.3.0",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.20.1",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.0",
    "@types/node": "^22.7.0",
    "@types/turndown": "^5.0.0",
    "c8": "^11.0.0",
    "miniflare": "^4.20260515.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
